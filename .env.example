# Django基本設定
DJANGO_SECRET_KEY=replace-with-your-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=backend.config.settings

# Django DB設定（Supabaseを使う場合でも一応記載）
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Supabase設定
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-or-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key ## recommended
# OpenAI設定
OPENAI_API_KEY=your-openai-api-key

# マスコット画像生成設定
MASCOT_REFERENCE_BUCKET=mascot-references
MASCOT_IMAGES_BUCKET=mascot-images

# CORS設定
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
